import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
}

struct Target {
  name : String
  program : String
  args : Array[String]
}

struct ResourceMeasurement {
  at_ms : Int
  cpu_value : Int
  working_set_bytes : Int
  private_bytes : Int
}

struct CpuMeasurement {
  at_ms : Int
  cpu_value : Int
}

struct ResourceSample {
  at_ms : Int
  cpu_value : Int
  cpu_percent_x100 : Int
  cpu_valid : Bool
  working_set_bytes : Int
  private_bytes : Int
}

fn arg_value(args : ArrayView[String], name : String, fallback : String) -> String {
  for i = 1; i < args.length(); i = i + 1 {
    if args[i] == name && i + 1 < args.length() {
      return args[i + 1]
    }
    if args[i].has_prefix(name + "=") {
      return args[i][name.length() + 1:].to_owned()
    }
  }
  fallback
}

fn positive(value : String, fallback : Int) -> Int {
  if value.length() == 0 { return fallback }
  let mut n = 0
  for c in value {
    if c < '0' || c > '9' { return fallback }
    n = n * 10 + c.to_int() - '0'.to_int()
  }
  if n > 0 { n } else { fallback }
}

fn parse_int_value(value : StringView) -> Int? {
  let text = value.trim()
  if text.length() == 0 { return None }
  let mut sign = 1
  let mut start = 0
  if text[0] == '-' {
    sign = -1
    start = 1
  } else if text[0] == '+' {
    start = 1
  }
  if start >= text.length() { return None }
  let mut result = 0
  for i = start; i < text.length(); i = i + 1 {
    let c = text[i]
    if c < '0' || c > '9' { return None }
    result = result * 10 + c.to_int() - '0'.to_int()
  }
  Some(result * sign)
}

fn parse_percent_x100(value : StringView) -> Int? {
  let text = value.trim()
  if text.length() == 0 { return None }
  let mut whole = 0
  let mut fraction = 0
  let mut fraction_digits = 0
  let mut seen_digit = false
  let mut seen_dot = false
  for c in text {
    if c >= '0' && c <= '9' {
      seen_digit = true
      if seen_dot {
        if fraction_digits < 2 {
          fraction = fraction * 10 + c.to_int() - '0'.to_int()
          fraction_digits = fraction_digits + 1
        }
      } else {
        whole = whole * 10 + c.to_int() - '0'.to_int()
      }
    } else if c == '.' && !seen_dot {
      seen_dot = true
    } else {
      return None
    }
  }
  if !seen_digit { return None }
  let scaled_fraction = if fraction_digits == 0 {
    0
  } else if fraction_digits == 1 {
    fraction * 10
  } else {
    fraction
  }
  Some(whole * 100 + scaled_fraction)
}

fn format_percent_x100(value : Int) -> String {
  let whole = value / 100
  let fraction = value % 100
  if fraction < 10 {
    "\{whole}.0\{fraction}"
  } else {
    "\{whole}.\{fraction}"
  }
}

fn normalize_fields(text : String) -> String {
  let normalized = StringBuilder()
  let mut in_token = false
  let mut need_separator = false
  for c in text {
    if c == ' ' || c == '\n' || c == '\r' || c == '\t' {
      if in_token {
        in_token = false
        need_separator = true
      }
    } else {
      if need_separator {
        normalized.write_char(',')
        need_separator = false
      }
      normalized.write_char(c)
      in_token = true
    }
  }
  normalized.to_string()
}

fn sample_measurement_text(text : String, windows : Bool) -> ResourceMeasurement? {
  if windows {
    let parts = text.trim().split(",").to_array()
    if parts.length() < 3 { return None }
    guard parse_int_value(parts[0]) is Some(cpu_value) else { return None }
    guard parse_int_value(parts[1]) is Some(working_set_bytes) else { return None }
    guard parse_int_value(parts[2]) is Some(private_bytes) else { return None }
    Some({
      at_ms: @async.now().to_int(),
      cpu_value,
      working_set_bytes,
      private_bytes,
    })
  } else {
    let fields = normalize_fields(text).split(",").to_array()
    if fields.length() < 2 { return None }
    guard parse_percent_x100(fields[0]) is Some(cpu_value) else { return None }
    guard parse_int_value(fields[1]) is Some(rss_kib) else { return None }
    Some({
      at_ms: @async.now().to_int(),
      cpu_value,
      working_set_bytes: rss_kib * 1024,
      private_bytes: 0,
    })
  }
}

async fn sample_measurement(pid : Int, windows : Bool) -> ResourceMeasurement? {
  if windows {
    let command = "$p=Get-Process -Id \{pid} -ErrorAction Stop; '{0},{1},{2}' -f [int64]$p.TotalProcessorTime.Ticks,[int64]$p.WorkingSet64,[int64]$p.PrivateMemorySize64"
    let (code, output, _) = @process.collect_output(
      "powershell.exe",
      ["-NoProfile", "-NonInteractive", "-Command", command],
      no_console_window=true,
    )
    if code != 0 { return None }
    sample_measurement_text(output.text(), true)
  } else {
    let (code, output, _) = @process.collect_output(
      "ps",
      ["-p", pid.to_string(), "-o", "%cpu=", "-o", "rss="],
      extra_env=Map([("LC_ALL", "C")]),
    )
    if code != 0 { return None }
    sample_measurement_text(output.text(), false)
  }
}

fn append_resource_sample(
  measurement : ResourceMeasurement,
  windows : Bool,
  previous : Ref[CpuMeasurement?],
  samples : Ref[Array[ResourceSample]],
) -> Unit {
  let (cpu_percent_x100, cpu_valid) = if windows {
    match previous.val {
      Some(prev) => {
        let elapsed = measurement.at_ms - prev.at_ms
        let delta = measurement.cpu_value - prev.cpu_value
        if elapsed > 0 {
          (if delta > 0 { delta / elapsed } else { 0 }, true)
        } else {
          (0, false)
        }
      }
      None => {
        (0, false)
      }
    }
  } else {
    (measurement.cpu_value, true)
  }
  previous.val = Some({ at_ms: measurement.at_ms, cpu_value: measurement.cpu_value })
  samples.val.push({
    at_ms: measurement.at_ms,
    cpu_value: measurement.cpu_value,
    cpu_percent_x100,
    cpu_valid,
    working_set_bytes: measurement.working_set_bytes,
    private_bytes: measurement.private_bytes,
  })
}

async fn sample_once(
  pid : Int,
  windows : Bool,
  previous : Ref[CpuMeasurement?],
  samples : Ref[Array[ResourceSample]],
) -> Unit {
  match sample_measurement(pid, windows) {
    Some(measurement) => append_resource_sample(measurement, windows, previous, samples)
    None => ()
  }
}

async fn sample_loop(
  pid : Int,
  windows : Bool,
  done : Ref[Bool],
  previous : Ref[CpuMeasurement?],
  samples : Ref[Array[ResourceSample]],
) -> Unit {
  while !done.val {
    sample_once(pid, windows, previous, samples)
    if !done.val { @async.sleep(250) }
  }
}

fn average_working_set(samples : Array[ResourceSample]) -> Int {
  if samples.length() == 0 { return 0 }
  // Keep the accumulator bounded; a long small-file run can otherwise
  // overflow MoonBit's platform Int when summing many RSS samples.
  let mut average = 0
  let mut count = 0
  for sample in samples {
    count = count + 1
    average = average + (sample.working_set_bytes - average) / count
  }
  average
}

fn peak_working_set(samples : Array[ResourceSample]) -> Int {
  let mut peak = 0
  for sample in samples {
    if sample.working_set_bytes > peak { peak = sample.working_set_bytes }
  }
  peak
}

fn average_private_bytes(samples : Array[ResourceSample]) -> Int {
  if samples.length() == 0 { return 0 }
  let mut average = 0
  let mut count = 0
  for sample in samples {
    count = count + 1
    average = average + (sample.private_bytes - average) / count
  }
  average
}

fn peak_private_bytes(samples : Array[ResourceSample]) -> Int {
  let mut peak = 0
  for sample in samples {
    if sample.private_bytes > peak { peak = sample.private_bytes }
  }
  peak
}

fn cpu_summary(samples : Array[ResourceSample]) -> (String, String) {
  let mut total = 0
  let mut count = 0
  let mut peak = 0
  for sample in samples {
    if sample.cpu_valid {
      total = total + sample.cpu_percent_x100
      count = count + 1
      if sample.cpu_percent_x100 > peak { peak = sample.cpu_percent_x100 }
    }
  }
  if count == 0 {
    ("", "")
  } else {
    (format_percent_x100(total / count), format_percent_x100(peak))
  }
}

async fn write_resource_csv(
  path : String,
  samples : Array[ResourceSample],
) -> Unit {
  let content = StringBuilder()
  content.write_string("timestamp_ms,cpu_raw,cpu_percent,working_set_bytes,private_bytes\n")
  for sample in samples {
    let cpu = if sample.cpu_valid {
      format_percent_x100(sample.cpu_percent_x100)
    } else {
      ""
    }
    content.write_string(
      "\{sample.at_ms},\{sample.cpu_value},\{cpu},\{sample.working_set_bytes},\{sample.private_bytes}\n",
    )
  }
  @fs.write_file(path, content.to_string())
}

fn resource_summary(
  windows : Bool,
  pid : Int,
  samples : Array[ResourceSample],
  source : String,
  resources : String,
) -> String {
  let (cpu_avg, cpu_peak) = cpu_summary(samples)
  let private_supported = if windows { "true" } else { "false" }
  let content = StringBuilder()
  content.write_string(
    "\{pid},\{samples.length()},\{cpu_avg},\{cpu_peak},\{average_working_set(samples)},\{peak_working_set(samples)},",
  )
  if windows {
    content.write_string("\{average_private_bytes(samples)},\{peak_private_bytes(samples)},")
  } else {
    content.write_string(",,")
  }
  content.write_string("\{private_supported},\{source},\{resources}")
  content.to_string()
}

fn selected(filter : String, name : String) -> Bool {
  filter == "" || filter == "all" || filter == name
}

fn url(scheme : String, port : String, path : String) -> String {
  "\{scheme}://127.0.0.1:\{port}\{path}"
}

fn node_program(_project : String) -> String {
  @env.get_env_var("HS_NODE").unwrap_or("node")
}

fn cli_program(project : String, full : Bool, windows : Bool) -> String {
  let suffix = if windows { ".exe" } else { "" }
  let flavor = if full { "http-server-mbt" } else { "http-server-mbt-thin" }
  @env.get_env_var(if full { "HS_CLI_FULL" } else { "HS_CLI_THIN" }).unwrap_or(
    project + "/target/candidate/cli/" + flavor +
      (if windows { "-windows-amd64" } else { "-linux-x64" }) + suffix,
  )
}

fn backend_args(args : Array[String], io_backend : String) -> Array[String] {
  if io_backend == "platform" || io_backend == "auto" {
    args
  } else {
    [..args, "--io-backend", io_backend]
  }
}

fn target_list(
  project : String,
  windows : Bool,
  port : String,
  root : String,
  _cert : String,
  _key : String,
  io_backend : String,
) -> Array[Target] {
  let node = node_program(project)
  let full_cli = cli_program(project, true, windows)
  let thin_cli = cli_program(project, false, windows)
  let original = @env.get_env_var("HS_ORIGINAL_BIN").unwrap_or(
    project + "/http-server/bin/http-server",
  )
  [
    {
      name: "cli-full",
      program: full_cli,
      args: backend_args(["--silent", "--port", port, root], io_backend),
    },
    {
      name: "cli-thin",
      program: thin_cli,
      args: backend_args(["--silent", "--port", port, root], io_backend),
    },
    {
      name: "napi",
      program: node,
      args: ["hosts/napi-server.mjs"],
    },
    {
      name: "wasmgc",
      program: node,
      args: ["hosts/wasm-server.mjs"],
    },
    {
      name: "original",
      program: node,
      args: [original, "-s", "-p", port, root],
    },
  ]
}

fn with_tls_args(target : Target, protocol : String, cert : String, key : String) -> Target {
  if protocol != "https" { return target }
  if target.name == "cli-full" {
    { ..target, args: [..target.args, "--cert", cert, "--key", key], }
  } else if target.name == "original" {
    { ..target, args: [..target.args, "-S", "-C", cert, "-K", key], }
  } else {
    target
  }
}

fn target_env(
  target : Target,
  project : String,
  port : String,
  protocol : String,
  root : String,
  cert : String,
  key : String,
  io_backend : String,
) -> Map[String, String] {
  let env : Map[String, String] = Map([])
  if target.name == "napi" || target.name == "wasmgc" {
    env["HS_PROJECT_ROOT"] = project
    env["HS_ROOT"] = root
    let backend_config = if target.name == "napi" && io_backend != "platform" {
      ",\"io_backend\":\"" + io_backend + "\""
    } else {
      ""
    }
    env["HS_CONFIG"] = "{\"root\":\"" + root + "\"" + backend_config + "}"
    if protocol == "https" {
      env["HS_TLS"] = "1"
      env["HS_CERT"] = cert
      env["HS_KEY"] = key
    }
  }
  env["PORT"] = port
  env
}

async fn write_urls(protocol : String, port : String, count : Int, small_count : Int) -> String {
  let scheme = if protocol == "https" { "https" } else { "http" }
  let path = "state/urls-\{protocol}.txt"
  let urls = StringBuilder()
  for i = 0; i < count; i = i + 1 {
    let index = i % small_count
    urls.write_string(url(scheme, port, "/small/\{index}.txt"))
    urls.write_char('\n')
  }
  @fs.write_file(path, urls.to_string())
  path
}

async fn load_args(
  tool : String,
  protocol : String,
  workload : String,
  port : String,
  requests : Int,
  connections : Int,
  duration : String,
  small_count : Int,
  output : String,
) -> Array[String] {
  let scheme = if protocol == "https" { "https" } else { "http" }
  let insecure = protocol == "https"
  if tool == "siege" {
    let repetitions = if workload == "large" { requests } else { 1 }
    let args = [
      "-b", "-q", "-j", "-c", connections.to_string(), "-r", repetitions.to_string(),
      "--no-parser",
    ]
    if workload == "large" {
      args.push(url(scheme, port, "/large.bin"))
    } else {
      args.push("-f")
      args.push(write_urls(protocol, port, small_count, small_count))
    }
    ignore(insecure)
    ignore(output)
    args
  } else if workload == "large" {
    let args = if duration.length() > 0 {
      [
        "--no-tui", "-z", duration, "-c", connections.to_string(),
        "--output-format", "json", "--output", output,
      ]
    } else {
      [
        "--no-tui", "-n", requests.to_string(), "-c", connections.to_string(),
        "--output-format", "json", "--output", output,
      ]
    }
    if insecure { args.push("--insecure") }
    args.push(url(scheme, port, "/large.bin"))
    args
  } else {
    let url_count = if duration.length() > 0 { small_count } else { requests }
    let urls = write_urls(protocol, port, url_count, small_count)
    let args = if duration.length() > 0 {
      [
        "--no-tui", "-z", duration, "-c", connections.to_string(),
        "--output-format", "json", "--output", output, "--urls-from-file",
      ]
    } else {
      [
        "--no-tui", "-n", requests.to_string(), "-c", connections.to_string(),
        "--output-format", "json", "--output", output, "--urls-from-file",
      ]
    }
    if insecure { args.push("--insecure") }
    args.push(urls)
    args
  }
}

async fn run_load(
  tool : String,
  args : Array[String],
  output : String,
) -> Int {
  if tool == "siege" {
    let (code, stdout, _) = @process.collect_output(
      "siege",
      args,
      extra_env=Map([("NO_COLOR", "true")]),
    )
    @fs.write_file(output, stdout.text())
    code
  } else {
    @shell.Cmd(
      "oha",
      args,
      env=Map([("NO_COLOR", "true")]),
      stdout=@shell.Redirect::Discard,
      stderr=@shell.Redirect::Discard,
    ).status()
  }
}

async fn ready(
  scheme : String,
  port : String,
  insecure : Bool,
) -> Bool {
  let probe_url = url(scheme, port, "/index.html")
  let curl = if @env.get_env_var("OS") == Some("Windows_NT") {
    "curl.exe"
  } else {
    "curl"
  }
  let mut ok = false
  // Node hosts loaded from a mounted Windows filesystem can take several
  // seconds to initialize under WSL. Keep readiness bounded but generous.
  for _ in 0..<100 {
    if !ok {
      let args = ["-fsS", "--max-time", "0.2", "-o", if @env.get_env_var("OS") == Some("Windows_NT") { "NUL" } else { "/dev/null" }]
      if insecure { args.push("-k") }
      args.push(probe_url)
      ok = @shell.Cmd(
        curl,
        args,
        stdout=@shell.Redirect::Discard,
        stderr=@shell.Redirect::Discard,
      ).status() == 0
      if !ok { @async.sleep(100) }
    }
  }
  ok
}

async fn run_case(
  target : Target,
  project : String,
  root : String,
  protocol : String,
  workload : String,
  port : String,
  requests : Int,
  connections : Int,
  duration : String,
  small_count : Int,
  cert : String,
  key : String,
  platform : String,
  windows : Bool,
  result_dir : String,
  io_backend : String,
  load_tool : String,
) -> Unit {
  let scheme = if protocol == "https" { "https" } else { "http" }
  let insecure = protocol == "https"
  let case_name = "\{platform}-\{io_backend}-\{target.name}-\{protocol}-\{workload}"
  let output = "\{result_dir}/\{case_name}.json"
  let stdout_log = "\{result_dir}/logs/\{case_name}.stdout.log"
  let stderr_log = "\{result_dir}/logs/\{case_name}.stderr.log"
  let resources = "\{result_dir}/resources/\{case_name}.csv"
  let command = with_tls_args(target, protocol, cert, key)
  let env = target_env(command, project, port, protocol, root, cert, key, io_backend)
  let request_args = load_args(
    load_tool,
    protocol,
    workload,
    port,
    requests,
    connections,
    duration,
    small_count,
    output,
  )
  @async.with_task_group() <| group => {
    let stdout = @process.redirect_to_file(stdout_log)
    let stderr = @process.redirect_to_file(stderr_log)
    let process = @process.spawn(
      group,
      command.program,
      command.args,
      extra_env=env,
      stdout=stdout,
      stderr=stderr,
      no_console_window=true,
      cancel_handler=@process.hard_cancel(),
    )
    let done = Ref(false)
    let previous = Ref(None)
    let samples : Ref[Array[ResourceSample]] = Ref([])
    let is_ready = ready(scheme, port, insecure)
    let mut exit_code = -1
    if is_ready {
      let sampler = group.spawn(() => sample_loop(process.pid, windows, done, previous, samples))
      let load = group.spawn(() => run_load(load_tool, request_args, output))
      exit_code = load.wait()
      done.val = true
      ignore(sampler.wait())
      sample_once(process.pid, windows, previous, samples)
    }
    done.val = true
    process.cancel()
    ignore(process.wait())
    if !is_ready {
      println("FAILED readiness: \{case_name}; see \{stderr_log}")
    }
    write_resource_csv(resources, samples.val)
    let source = if windows {
      "windows-powershell:Get-Process"
    } else {
      "linux-ps:%cpu+rss"
    }
    @fs.write_file(
      "\{result_dir}/index.csv",
      "\{platform},\{io_backend},\{target.name},\{protocol},\{workload},\{requests},\{connections},\{exit_code},\{output}," +
        resource_summary(windows, process.pid, samples.val, source, resources) + ",\{duration}\n",
      create_mode=@fs.CreateMode::OpenOrCreate,
      append=true,
    )
    println("case=\{case_name} ready=\{is_ready} exit=\{exit_code}")
  }
}

async fn main {
  let args = @env.args()
  let project = @env.get_env_var("HS_PROJECT_ROOT").unwrap_or(
    arg_value(args, "--project-root", ""),
  )
  if project == "" {
    fail("HS_PROJECT_ROOT or --project-root is required")
  }
  let platform = @env.get_env_var("BENCH_PLATFORM").unwrap_or(
    if @env.get_env_var("OS") == Some("Windows_NT") { "windows" } else { "linux" },
  )
  let windows = platform == "windows"
  let root = arg_value(args, "--root", "data/public")
  let port = arg_value(args, "--port", "18080")
  let requests = positive(arg_value(args, "--requests", "12"), 12)
  let connections = positive(arg_value(args, "--connections", "4"), 4)
  let duration = arg_value(args, "--duration", "")
  let small_count = positive(arg_value(args, "--small-count", "2048"), 2048)
  let target_filter = arg_value(args, "--target", "all")
  let protocol_filter = arg_value(args, "--protocol", "all")
  let workload_filter = arg_value(args, "--workload", "all")
  let io_backend = @env.get_env_var("BENCH_IO_BACKEND").unwrap_or(
    arg_value(args, "--io-backend", "platform"),
  )
  let load_tool = @env.get_env_var("BENCH_LOAD_TOOL").unwrap_or("oha")
  let cert = arg_value(args, "--cert", "state/certs/server.crt")
  let key = arg_value(args, "--key", "state/certs/server.key")
  let result_dir = @env.get_env_var("BENCH_RESULT_DIR").unwrap_or("results")
  if !@fs.exists(result_dir + "/logs") {
    @fs.mkdir(result_dir + "/logs", recursive=true)
  }
  if !@fs.exists(result_dir + "/resources") {
    @fs.mkdir(result_dir + "/resources", recursive=true)
  }
  @fs.write_file(
    result_dir + "/index.csv",
    "platform,io_backend,target,protocol,workload,requests,connections,exit_code,output,pid,resource_samples,cpu_avg_percent,cpu_peak_percent,working_set_avg_bytes,working_set_peak_bytes,private_bytes_avg_bytes,private_bytes_peak_bytes,private_bytes_supported,resource_source,resources,duration\n",
    append=false,
  )
  let targets = target_list(project, windows, port, root, cert, key, io_backend)
  for target in targets {
    if selected(target_filter, target.name) {
      for protocol in ["http", "https"] {
        if selected(protocol_filter, protocol) {
          if protocol == "https" && target.name == "cli-thin" {
            @fs.write_file(
              result_dir + "/index.csv",
              "\{platform},\{io_backend},\{target.name},\{protocol},unsupported,0,0,0,,,,,,,,,,false,unsupported,\n",
              create_mode=@fs.CreateMode::OpenOrCreate,
              append=true,
            )
            println("case=\{platform}-\{target.name}-\{protocol} skipped=unsupported")
          } else {
            for workload in ["large", "small-files"] {
              if selected(workload_filter, workload) {
                run_case(
                  target,
                  project,
                  root,
                  protocol,
                  workload,
                  port,
                  if workload == "large" { requests } else { small_count },
                  connections,
                  duration,
                  small_count,
                  cert,
                  key,
                  platform,
                  windows,
                  result_dir,
                  io_backend,
                  load_tool,
                )
              }
            }
          }
        }
      }
    }
  }
}
